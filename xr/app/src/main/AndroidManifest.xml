<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Kept targetSdk 37 (per the SDK 37/37/24 hard constraint), so outgoing TCP
        to a LAN address requires this runtime permission (vr-docs Q4). On
        targetSdk 36 or lower this declaration must be dropped.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        android:minSdkVersion="37" />

    <uses-feature
        android:name="android.software.xr.api.spatial"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.xr.input.controller"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.xr.input.hand_tracking"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.AgentOfficeXR"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            Launch in Home Space: the app opens as a normal window alongside other
            apps (multitasking). Spatial panels (Full Space) come in a later ticket;
            every screen must render its 2D fallback until then.
        -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_HOME_SPACE" />

        <!--
            androidx.xr.arcore pulls in ARCore transitively, which is an optional
            feature — declare the dependency type explicitly or Play Console upload
            validation rejects the bundle ("ARCore dependency type... missing").
        -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <!-- Preload the ML Kit barcode UI module so the first scan is fast. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|uiMode"
            android:theme="@style/Theme.AgentOfficeXR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
