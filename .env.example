# Every setting Droid Office and its installers read from the environment.
#
# The office does not load .env files. Export a setting in the shell that starts the office
# (`export DROID_OFFICE_CITY="Berlin"`), or set it in its systemd unit as an `Environment=` line
# (`Environment=DROID_OFFICE_CITY=Berlin`) or in the unit's `EnvironmentFile=` (an office deployed
# with deploy/aws.sh reads /etc/droid-office/env).
#
# Every line below is commented out, so nothing changes until you uncomment it. Unset is the
# default; an empty value is not always the same as unset. A command-line flag wins over its
# environment variable.

# ---------------------------------------------------------------------------------------------
# The office (droid-office)
# ---------------------------------------------------------------------------------------------

# Where the office keeps its data when started without a [dir] (--home). Default: ~/droid-office.
# DROID_OFFICE_HOME=~/droid-office

# The workspace folder: where the office looks for your existing git checkouts to add as floors
# (--projects). Nothing is cloned. Default: a code folder in the home folder (~/Workspace, ~/code,
# ~/repos…), else the home folder, or the Workspace folder picked in Settings.
# DROID_OFFICE_PROJECTS=~/Workspace

# Port to listen on (--port). Default: 4600.
# PORT=4600

# Office password (--password). Default: a random one, generated once and saved in
# <dir>/.droid-office/config.json. Generate one with: openssl rand -base64 24
# DROID_OFFICE_PASSWORD=replace-with-a-long-random-password

# Default agent command for new workers (--agent). Default: droid.
# DROID_OFFICE_AGENT=droid

# Extra arguments for the configured agent, split like a shell would (--agent-args). Default: none.
# DROID_OFFICE_AGENT_ARGS="--model opus"

# Daily budget in USD for tracked Claude Code spend; everyone is warned once the day's spend
# passes it (--budget). Other providers' spend is excluded. Default: no budget.
# DROID_OFFICE_BUDGET=20

# Any value but 0 refuses new hires for the rest of the day once the budget is spent
# (--budget-pause). Default: off.
# DROID_OFFICE_BUDGET_PAUSE=1

# The most workers the office runs at once, across every floor: a whole number from 1 to 500
# (--max-workers). Admins can lower it from Settings but not raise it past this. Default: no limit.
# DROID_OFFICE_MAX_WORKERS=6

# Slack or Discord webhook (http or https) posted to when a worker needs input or finishes
# (--webhook). An empty value turns it off. Default: unset, which keeps the one saved in Settings.
# DROID_OFFICE_WEBHOOK=https://hooks.slack.com/services/T000/B000/XXXXXXXX

# A real city, or "lat,lon", whose live forecast from open-meteo.com drives the sun and weather
# (--city). Default: none; the sun follows this machine's clock and the weather is made up.
# DROID_OFFICE_CITY="Portland, Oregon"

# Pin the weather: clear, cloudy, rain, storm, snow or fog (--weather). Default: not pinned.
# DROID_OFFICE_WEATHER=clear

# Any non-empty value skips the first-start walkthrough (which folder your projects are in, the first
# project), and `droid-office setup` asks nothing, even in a terminal. Default: unset.
# CI=1

# ---------------------------------------------------------------------------------------------
# Offices deployed with deploy/aws.sh (deploy/provision.sh sets these for you)
# ---------------------------------------------------------------------------------------------

# Address teammates SSH-tunnel to; turns on team invites from the office. Default: none.
# DROID_OFFICE_PUBLIC_HOST=203.0.113.10

# The helper that edits the office user's authorized_keys for team invites.
# Default: /usr/local/bin/droid-office-team (installed by deploy/provision.sh).
# DROID_OFFICE_TEAM_HELPER=/usr/local/bin/droid-office-team

# 1 lets the office upgrade itself from its UI: it builds the new version, then exits, so only set
# it under a supervisor that restarts it (systemd Restart=always), on a git checkout that is on a
# branch. Default: off.
# DROID_OFFICE_SELF_UPDATE=1

# ---------------------------------------------------------------------------------------------
# The installers (install.sh and install.ps1)
# ---------------------------------------------------------------------------------------------

# Install this release (a tag like v0.1.68) instead of the newest.
# DROID_OFFICE_VERSION=v0.1.68

# Where releases go. Default: ~/.local/share/droid-office ($XDG_DATA_HOME/droid-office when set);
# on Windows %LOCALAPPDATA%\droid-office.
# DROID_OFFICE_INSTALL_DIR=~/.local/share/droid-office

# Where the `droid-office` command goes. Default: ~/.local/bin; on Windows <install dir>\bin.
# Empty (install.sh) or `none` (install.ps1) writes no command.
# DROID_OFFICE_BIN_DIR=~/.local/bin

# 1 installs the release but doesn't start the office.
# DROID_OFFICE_INSTALL_ONLY=1

# Install this release tarball (a local file) instead of downloading one.
# DROID_OFFICE_TARBALL=/path/to/droid-office.tgz

# install.ps1 only: 1 writes the `droid-office` command but leaves your user PATH alone.
# DROID_OFFICE_NO_MODIFY_PATH=1
