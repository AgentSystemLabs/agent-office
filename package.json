{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "A cartoon 3D multiplayer office where your team spawns Claude Code workers at desks, shares live terminals, talks over voice, and tracks GitHub issues and PRs.",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "demo:floor-host": "node --import tsx scripts/demo-floor-host.ts",
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/cli.ts --port 4600 --password 123 --no-open --host 0.0.0.0\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node bin/agent-office.js",
    "prepare": "npm run build",
    "e2e:floor-host": "node --import tsx scripts/e2e-floor-host.mjs",
    "e2e:floor-ride": "node --import tsx scripts/e2e-floor-ride.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
